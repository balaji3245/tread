# Server settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001"]

# Market Data settings
MT5_SYMBOL=XAUUSD
HISTORICAL_CANDLE_COUNT=300
TICK_POLL_INTERVAL_MS=100
STALE_DATA_THRESHOLD_SECONDS=5.0

# Optional custom MT5 terminal path (e.g. "C:\\Program Files\\MetaTrader 5\\terminal64.exe")
MT5_PATH=

# Enable realistic simulation fallback when MT5 is not running/installed on platform
MT5_MOCK_FALLBACK=true
